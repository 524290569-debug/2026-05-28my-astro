---
import "../styles/rain-position.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => `${basePath}${path}`;
---

<div class="rp-page" data-rain-position data-active-section="manifest">
  <div class="rp-scroll-progress" aria-hidden="true"><span data-rp-progress></span></div>

  <header class="rp-nav" data-rp-nav-shell>
    <a class="rp-nav-brand" href={basePath} aria-label="返回灰雨电台">
      <span aria-hidden="true"></span><b>GRR—04</b><em>灰雨电台</em>
    </a>
    <nav aria-label="位置改变章节导航">
      <a href="#manifest" data-rp-nav-link="manifest" aria-current="location">命题</a>
      <a href="#high" data-rp-nav-link="high">高处</a>
      <a href="#below" data-rp-nav-link="below">地下</a>
      <a href="#between" data-rp-nav-link="between">穿行</a>
      <a href="#compare" data-rp-nav-link="compare">校准</a>
    </nav>
    <a class="rp-nav-back" href={basePath}>返回电台 <span>↗</span></a>
  </header>

  <aside class="rp-rail" aria-label="章节快速定位">
    <span>POSITION / <b data-rp-current-code>00</b></span>
    <nav>
      <a href="#manifest" data-rp-rail-link="manifest" aria-current="location"><i></i><em>00</em><b>命题</b></a>
      <a href="#high" data-rp-rail-link="high"><i></i><em>01</em><b>高处</b></a>
      <a href="#below" data-rp-rail-link="below"><i></i><em>02</em><b>地下</b></a>
      <a href="#between" data-rp-rail-link="between"><i></i><em>03</em><b>穿行</b></a>
      <a href="#compare" data-rp-rail-link="compare"><i></i><em>04</em><b>校准</b></a>
    </nav>
  </aside>

  <main id="position-main">
    <section id="manifest" class="rp-hero" data-rp-section="manifest" aria-labelledby="rp-title">
      <div class="rp-hero-scene" data-rp-hero-scene aria-hidden="true">
        <img class="rp-hero-main" src={assetPath("assets/position/position-hero.webp")} width="1672" height="941" alt="" />
        <div class="rp-rain-layer"></div><div class="rp-hero-mask"></div>
      </div>
      <div class="rp-hero-coordinate" aria-hidden="true"><span>Y</span><i></i><b>03</b><i></i><span>X</span></div>
      <div class="rp-hero-copy" data-rp-reveal>
        <p class="rp-eyebrow"><span>NEW PAGE / 00</span> CINEMATIC INTERACTIVE ESSAY</p>
        <h1 id="rp-title"><span>位置</span><span>改变</span></h1>
        <p class="rp-hero-en">POSITION <b>SHIFT</b></p>
        <p class="rp-hero-thesis">雨没有重写城市。<br />它改变你与城市之间的距离。</p>
        <div class="rp-hero-actions">
          <a href="#high" class="rp-primary-action">开始移动 <span>↓</span></a>
          <a href="#compare" class="rp-text-action">直接进入距离校准</a>
        </div>
      </div>

      <div class="rp-focus-console rp-focus-abstract" data-rp-reveal>
        <div class="rp-focus-head"><p>FOCUS / VIEWING DISTANCE</p><output for="rp-focus" data-rp-focus-output>46 / 100</output></div>
        <div class="rp-focus-window" data-rp-focus-window aria-label="抽象距离示意图">
          <div class="rp-focus-city" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <div class="rp-focus-reticle" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <p data-rp-focus-copy>城市仍是轮廓，你与它保持完整的距离。</p>
        </div>
        <label for="rp-focus"><span>环境</span><b>拖动改变观看距离</b><span>细节</span></label>
        <input id="rp-focus" data-rp-focus type="range" min="0" max="100" value="46" step="1" />
        <div class="rp-focus-scale" aria-hidden="true"><span>00</span><i></i><i></i><i></i><span>100</span></div>
      </div>
      <footer class="rp-hero-foot" aria-hidden="true"><span>SCROLL / POSITION CHANGES WITH YOU</span><span>FOUR FORMS / NO REPEATED FRAME</span></footer>
    </section>

    <section class="rp-statement" aria-label="页面命题" data-rp-reveal>
      <span>不是三个相同模板换三张图。</span>
      <p>高度、遮蔽与速度，各自需要一种观看方法。</p>
    </section>

    <section id="high" class="rp-high" data-rp-section="high" aria-labelledby="high-title">
      <div class="rp-high-copy" data-rp-reveal>
        <p class="rp-chapter-kicker"><span>01</span> POSITION / EXPOSED</p>
        <h2 id="high-title">高处</h2>
        <h3>越接近天空，越需要主动选择落点。</h3>
        <p>屋顶给出宽阔视野，也抹平尺度。这里不缩放整张照片，而是用三个坐标把视线钉在远城、积水和天线上。</p>
        <div class="rp-high-points" role="group" aria-label="选择屋顶观察坐标">
          <button type="button" data-rp-high-point data-x="57%" data-y="37%" data-copy="远城没有消失，它被压缩成一条低亮度的水平线。" aria-pressed="true"><span>A</span>远城</button>
          <button type="button" data-rp-high-point data-x="48%" data-y="77%" data-copy="积水把天空折回脚下，高度突然有了第二个方向。" aria-pressed="false"><span>B</span>积水</button>
          <button type="button" data-rp-high-point data-x="89%" data-y="28%" data-copy="天线不是风景，它把空旷切成可以测量的方向。" aria-pressed="false"><span>C</span>天线</button>
        </div>
        <p class="rp-high-readout" data-rp-high-copy>远城没有消失，它被压缩成一条低亮度的水平线。</p>
      </div>
      <figure class="rp-high-observatory" data-rp-parallax data-rp-reveal>
        <img src={assetPath("assets/position/position-high.webp")} width="1672" height="941" alt="雨夜屋顶、天线与远处城市灯光" loading="eager" />
        <div class="rp-high-crosshair" data-rp-high-marker aria-hidden="true"><i></i><b>A</b></div>
        <figcaption><span>OBSERVATORY / 01</span><b>点击坐标改变视线落点</b></figcaption>
      </figure>
    </section>

    <section id="below" class="rp-below" data-rp-section="below" aria-labelledby="below-title">
      <div class="rp-below-frame" data-rp-reveal>
        <img src={assetPath("assets/position/position-below.webp")} width="1672" height="941" alt="潮湿地下通道、冷白灯带与远处出口" loading="lazy" />
        <div class="rp-depth-curtain" aria-hidden="true"></div><div class="rp-depth-line" aria-hidden="true"><span>DEPTH</span></div>
        <div class="rp-depth-meter" aria-hidden="true"><span>入口</span><i></i><span>内部</span></div>
      </div>
      <div class="rp-below-console" data-rp-depth-shell data-rp-reveal>
        <p class="rp-chapter-kicker"><span>02</span> POSITION / SHELTERED</p>
        <h2 id="below-title">地下</h2>
        <h3>向内一步，雨就从触感变成回声。</h3>
        <p>这里的交互不是选取画面局部，而是模拟从出口走向结构内部。亮度、混响和方向感会沿同一条深度轴改变。</p>
        <div class="rp-depth-output"><output for="rp-depth" data-rp-depth-output>34 M</output><span data-rp-depth-state>边界仍然可见</span></div>
        <input id="rp-depth" data-rp-depth type="range" min="0" max="100" value="34" step="1" />
        <div class="rp-depth-scale" aria-hidden="true"><span>RAIN</span><i></i><span>ECHO</span><i></i><span>HUM</span></div>
        <p class="rp-depth-copy" data-rp-depth-copy>出口还在身后发亮，脚步声刚刚开始变长。</p>
      </div>
    </section>

    <section id="between" class="rp-between" data-rp-section="between" aria-labelledby="between-title">
      <header class="rp-between-head" data-rp-reveal>
        <p class="rp-chapter-kicker"><span>03</span> POSITION / IN TRANSIT</p>
        <h2 id="between-title">穿行</h2>
        <p>高架没有可停留的中心。画面按时间而不是坐标展开：启动一次行程，看桥下、轨道和远城依次退出视线。</p>
      </header>
      <div class="rp-journey" data-rp-journey data-rp-reveal>
        <div class="rp-journey-window">
          <img src={assetPath("assets/position/position-between.webp")} width="1672" height="941" alt="雨夜高架轨道与远处密集城市楼群" loading="lazy" data-rp-journey-image />
          <div class="rp-speed-lines" aria-hidden="true"></div>
          <output data-rp-journey-output>00:00</output>
        </div>
        <div class="rp-transport">
          <button type="button" data-rp-journey-toggle aria-pressed="false"><span>▶</span><b>启动行程</b></button>
          <input data-rp-journey-range aria-label="行程时间" type="range" min="0" max="100" value="0" step="1" />
          <p data-rp-journey-copy>列车尚未进入桥面，城市仍像一个可以抵达的目的地。</p>
        </div>
        <div class="rp-journey-stations" aria-hidden="true"><span>起点 / 静止</span><span>桥心 / 加速</span><span>远端 / 离场</span></div>
      </div>
    </section>

    <section id="compare" class="rp-calibration" data-rp-section="compare" aria-labelledby="compare-title">
      <div class="rp-calibration-head" data-rp-reveal>
        <p class="rp-chapter-kicker"><span>04</span> DISTANCE CALIBRATION</p>
        <h2 id="compare-title">不是总结。<br />重新设定你的坐标。</h2>
        <p>这一段不再展示前面的照片。拖动三个变量，页面只计算当下的观看距离，并给出新的描述。</p>
      </div>
      <div class="rp-calibration-console" data-rp-calibration data-rp-reveal>
        <div class="rp-calibration-orbit" aria-hidden="true">
          <i data-rp-calibration-point></i><span>YOU</span><b>CITY</b>
        </div>
        <div class="rp-calibration-result">
          <span>DISTANCE INDEX</span><output data-rp-calibration-output>48</output><p data-rp-calibration-copy>你看得见结构，也仍能感到天气。</p>
        </div>
        <div class="rp-calibration-controls">
          <label>高度 <output data-rp-metric-output="height">62</output><input type="range" min="0" max="100" value="62" data-rp-metric="height" /></label>
          <label>遮蔽 <output data-rp-metric-output="shelter">38</output><input type="range" min="0" max="100" value="38" data-rp-metric="shelter" /></label>
          <label>速度 <output data-rp-metric-output="speed">44</output><input type="range" min="0" max="100" value="44" data-rp-metric="speed" /></label>
        </div>
      </div>
    </section>

    <section id="after" class="rp-ending" aria-labelledby="ending-title">
      <div data-rp-reveal>
        <p>AFTER THE RAIN / 05</p>
        <h2 id="ending-title">城市没有给出结论。</h2>
        <p>页面到这里停止解释。高度、遮蔽和速度会继续变化，而你下一次站立的位置，将产生另一种城市。</p>
      </div>
      <footer><span>POSITION SHIFT / END OF TRANSMISSION</span><span>05:41 / SIGNAL CLOSED</span></footer>
    </section>
  </main>
</div>

<script>
  const page = document.querySelector("[data-rain-position]");

  if (page) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const progressBar = page.querySelector("[data-rp-progress]");
    const navShell = page.querySelector("[data-rp-nav-shell]");
    const currentCode = page.querySelector("[data-rp-current-code]");
    const sections = [...page.querySelectorAll("[data-rp-section]")];
    const navLinks = [...page.querySelectorAll("[data-rp-nav-link]")];
    const railLinks = [...page.querySelectorAll("[data-rp-rail-link]")];
    const revealItems = [...page.querySelectorAll("[data-rp-reveal]")];
    let frame = 0;
    let hashLockUntil = 0;
    const sectionCodes = { manifest: "00", high: "01", below: "02", between: "03", compare: "04" };

    const setActiveSection = (id) => {
      page.dataset.activeSection = id;
      if (currentCode) currentCode.textContent = sectionCodes[id] || "00";
      [...navLinks, ...railLinks].forEach((link) => {
        const linkId = link.dataset.rpNavLink || link.dataset.rpRailLink;
        if (linkId === id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    [...navLinks, ...railLinks, ...page.querySelectorAll('a[href^="#"]')].forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.getAttribute("href")?.slice(1);
        if (id && sectionCodes[id]) {
          hashLockUntil = performance.now() + 900;
          setActiveSection(id);
        }
      });
    });

    const updateScroll = () => {
      frame = 0;
      const root = document.documentElement;
      const scrollable = root.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      progressBar?.style.setProperty("transform", `scaleX(${progress})`);
      navShell?.toggleAttribute("data-scrolled", window.scrollY > 24);
      page.style.setProperty("--page-progress", String(progress));
      let activeId = "manifest";
      let activeDistance = Number.POSITIVE_INFINITY;
      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        const distance = Math.abs(rect.top - window.innerHeight * 0.28);
        if (rect.bottom > window.innerHeight * 0.22 && distance < activeDistance) {
          activeDistance = distance;
          activeId = section.dataset.rpSection || "manifest";
        }
      });
      if (performance.now() > hashLockUntil) setActiveSection(activeId);
    };

    window.addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(updateScroll); }, { passive: true });
    window.addEventListener("resize", () => { if (!frame) frame = requestAnimationFrame(updateScroll); }, { passive: true });
    window.addEventListener("hashchange", () => { const id = location.hash.slice(1); if (sectionCodes[id]) setActiveSection(id); });

    const focusControl = page.querySelector("[data-rp-focus]");
    const focusWindow = page.querySelector("[data-rp-focus-window]");
    const focusOutput = page.querySelector("[data-rp-focus-output]");
    const focusCopy = page.querySelector("[data-rp-focus-copy]");
    const updateFocus = () => {
      const value = Number(focusControl?.value || 0);
      focusWindow?.style.setProperty("--focus", String(value / 100));
      if (focusOutput) focusOutput.textContent = `${String(value).padStart(2, "0")} / 100`;
      if (focusCopy) focusCopy.textContent = value < 34 ? "城市仍是轮廓，你与它保持完整的距离。" : value < 68 ? "轮廓开始分层，屋顶从城市中浮现。" : "细节占据视野，完整的城市暂时退场。";
    };
    focusControl?.addEventListener("input", updateFocus);
    updateFocus();

    const highMarker = page.querySelector("[data-rp-high-marker]");
    const highCopy = page.querySelector("[data-rp-high-copy]");
    const highPoints = [...page.querySelectorAll("[data-rp-high-point]")];
    highPoints.forEach((button, index) => button.addEventListener("click", () => {
      highPoints.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      highMarker?.style.setProperty("--point-x", button.dataset.x || "50%");
      highMarker?.style.setProperty("--point-y", button.dataset.y || "50%");
      const markerCode = highMarker?.querySelector("b");
      if (markerCode) markerCode.textContent = String.fromCharCode(65 + index);
      if (highCopy) highCopy.textContent = button.dataset.copy || "";
    }));

    const depthControl = page.querySelector("[data-rp-depth]");
    const depthShell = page.querySelector("[data-rp-depth-shell]");
    const belowSection = page.querySelector(".rp-below");
    const depthOutput = page.querySelector("[data-rp-depth-output]");
    const depthState = page.querySelector("[data-rp-depth-state]");
    const depthCopy = page.querySelector("[data-rp-depth-copy]");
    const updateDepth = () => {
      const value = Number(depthControl?.value || 0);
      belowSection?.style.setProperty("--depth", String(value / 100));
      depthShell?.style.setProperty("--depth", String(value / 100));
      if (depthOutput) depthOutput.textContent = `${String(value).padStart(2, "0")} M`;
      if (value < 34) {
        if (depthState) depthState.textContent = "雨声仍占主导";
        if (depthCopy) depthCopy.textContent = "出口还在身后发亮，脚步声尚未形成回声。";
      } else if (value < 68) {
        if (depthState) depthState.textContent = "边界正在消失";
        if (depthCopy) depthCopy.textContent = "雨退成地面的反光，通风与电流声开始接管空间。";
      } else {
        if (depthState) depthState.textContent = "结构成为全部环境";
        if (depthCopy) depthCopy.textContent = "出口只剩一个亮点，你开始用回声而不是天气判断距离。";
      }
    };
    depthControl?.addEventListener("input", updateDepth);
    updateDepth();

    const journey = page.querySelector("[data-rp-journey]");
    const journeyToggle = page.querySelector("[data-rp-journey-toggle]");
    const journeyRange = page.querySelector("[data-rp-journey-range]");
    const journeyOutput = page.querySelector("[data-rp-journey-output]");
    const journeyCopy = page.querySelector("[data-rp-journey-copy]");
    let journeyFrame = 0;
    let lastJourneyTime = 0;
    let journeyValue = Number(journeyRange?.value || 0);
    const updateJourney = (nextValue = Number(journeyRange?.value || 0)) => {
      const value = Math.min(100, Math.max(0, nextValue));
      journeyValue = value;
      if (journeyRange) journeyRange.value = String(Math.round(value));
      journey?.style.setProperty("--journey", String(value / 100));
      const seconds = Math.round(value * 0.42);
      if (journeyOutput) journeyOutput.textContent = `00:${String(seconds).padStart(2, "0")}`;
      if (journeyCopy) journeyCopy.textContent = value < 34 ? "列车尚未进入桥心，城市仍像一个可以抵达的目的地。" : value < 68 ? "桥下街区横向滑过，当前位置只剩速度和轨道。" : "远端灯光退出画面，经过本身取代了目的地。";
    };
    const stopJourney = () => {
      cancelAnimationFrame(journeyFrame);
      journeyFrame = 0;
      journeyToggle?.setAttribute("aria-pressed", "false");
      const label = journeyToggle?.querySelector("b");
      if (label) label.textContent = "启动行程";
    };
    const tickJourney = (time) => {
      if (!lastJourneyTime) lastJourneyTime = time;
      journeyValue = Math.min(100, journeyValue + (time - lastJourneyTime) / 90);
      lastJourneyTime = time;
      updateJourney(journeyValue);
      if (journeyValue >= 100) { stopJourney(); lastJourneyTime = 0; return; }
      journeyFrame = requestAnimationFrame(tickJourney);
    };
    journeyToggle?.addEventListener("click", () => {
      if (journeyFrame) { stopJourney(); lastJourneyTime = 0; return; }
      if (journeyValue >= 100) journeyValue = 0;
      journeyToggle.setAttribute("aria-pressed", "true");
      const label = journeyToggle.querySelector("b");
      if (label) label.textContent = "暂停行程";
      journeyFrame = requestAnimationFrame(tickJourney);
    });
    journeyRange?.addEventListener("input", () => { stopJourney(); journeyValue = Number(journeyRange.value); updateJourney(journeyValue); });
    updateJourney();

    const calibration = page.querySelector("[data-rp-calibration]");
    const metricInputs = [...page.querySelectorAll("[data-rp-metric]")];
    const calibrationOutput = page.querySelector("[data-rp-calibration-output]");
    const calibrationCopy = page.querySelector("[data-rp-calibration-copy]");
    const updateCalibration = () => {
      const values = Object.fromEntries(metricInputs.map((input) => [input.dataset.rpMetric, Number(input.value)]));
      metricInputs.forEach((input) => { const output = page.querySelector(`[data-rp-metric-output="${input.dataset.rpMetric}"]`); if (output) output.textContent = input.value; });
      const score = Math.round((values.height || 0) * 0.36 + (values.shelter || 0) * 0.34 + (values.speed || 0) * 0.3);
      calibration?.style.setProperty("--distance-index", String(score / 100));
      if (calibrationOutput) calibrationOutput.textContent = String(score).padStart(2, "0");
      if (calibrationCopy) calibrationCopy.textContent = score < 34 ? "你贴近表面，细节强烈，城市失去整体。" : score < 68 ? "你看得见结构，也仍能感到天气。" : "你离开现场，城市重新变成一个完整而遥远的轮廓。";
    };
    metricInputs.forEach((input) => input.addEventListener("input", updateCalibration));
    updateCalibration();

    if (finePointer.matches && !reduceMotion.matches) {
      page.querySelectorAll("[data-rp-parallax]").forEach((media) => {
        media.addEventListener("pointermove", (event) => {
          const rect = media.getBoundingClientRect();
          media.style.setProperty("--pointer-shift-x", `${((event.clientX - rect.left) / rect.width - 0.5) * 10}px`);
          media.style.setProperty("--pointer-shift-y", `${((event.clientY - rect.top) / rect.height - 0.5) * 7}px`);
        });
        media.addEventListener("pointerleave", () => { media.style.setProperty("--pointer-shift-x", "0px"); media.style.setProperty("--pointer-shift-y", "0px"); });
      });
    }

    if ("IntersectionObserver" in window && !reduceMotion.matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.setAttribute("data-visible", ""); observer.unobserve(entry.target); } }), { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));
    } else revealItems.forEach((item) => item.setAttribute("data-visible", ""));

    reduceMotion.addEventListener("change", () => { stopJourney(); revealItems.forEach((item) => item.setAttribute("data-visible", "")); updateScroll(); });
    setActiveSection(location.hash.slice(1) || "manifest");
    updateScroll();
  }
</script>
