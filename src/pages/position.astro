---
import BaseLayout from "../layouts/BaseLayout.astro";
import RainPositionExperience from "../components/RainPositionExperience.astro";
---

<BaseLayout
  title="位置改变｜雨如何改变人与城市的距离"
  description="一张电影化交互散文：通过聚焦、下沉与穿行，比较人在雨中面对城市的三种位置。"
  skipTarget="#position-main"
  preloadImages={[
    { href: "assets/position/position-hero.webp", type: "image/webp", fetchPriority: "high" },
    { href: "assets/position/position-high.webp", type: "image/webp", fetchPriority: "high" }
  ]}
>
  <RainPositionExperience />
</BaseLayout>
